<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="index.css">
  <title>Zaijing's portfolio</title>
</head>

<body>
      <!-- Navigation bar -->
      <div class="nav">
        <div class="nav-content">
          <img id="logo-nav" src="Pictures/Intro and footer/Brand logo without font.png" alt="Brand Logo">
          <nav class="nav-bar">
            <ul>
              <li><a href="#" data-page="Designs" class="active">Projects</a></li>
              <li><a href="#" data-page="About me">About me</a></li>
              <li><a href="./res/Resume.pdf" download>Resume</a></li>
            </ul>
          </nav>
        </div>
      </div>

    <div class="container">
      <!-- Big container for all things -->
      <div class="Intro">
        <!-- Introduction part -->
        <div class="font">
          <!-- The font at left side -->
          <h1>Hello, I'm Zaijing Liu</h1>
          <h1 class="blue-text">
          <span id="typing-text"></span>
          <span class="cursor">_</span>
          </h1>
          <p>Pursuing a Master degree in Human Factor Ergonomics with UX concentration, I'm passionate about crafting inclusive,
          user-centered experiences that prioritize equity and intuitive design.</p>
        </div>
        <div class="photo">
          <!-- Photo at right side -->
          <img src="Pictures/Intro and footer/Intro.jpg" alt="My photo">
        </div>
      </div>
    </div>
    
    <div class="container">
       <!-- Each page show here -->
      <main id="main-content">
        <div id="content">
        </div>
      </main>

      <!-- Footer show here -->
      <div class="footer">
        <div class="footer-left">
          <!-- Logo at left side of footer -->
          <img src="Pictures/Intro and footer/Brand logo without font.png" alt="Brand logo">
        </div>
        <div class="footer-right">
          <!-- Info at right side of footer -->
          <div class="email">
            <img src="Pictures/Intro and footer/email_svgrepo.com.png" alt="Email logo">
            <p>Chlora006@gmail.com </p>
          </div>
          <div class="career-logo">
            <a href="https://www.linkedin.com/in/zaijing-liu-161275271/" target="_blank">
               <img src="Pictures/Intro and footer/Linkedin.png" alt="Linkedin">
            </a>
            <a href="https://www.instagram.com/chloraliu" target="_blank">
              <img src="Pictures/Intro and footer/Instagram.png" alt="Instagram">
            </a>
            <a href="https://github.com/Chlora06" target="_blank">
              <img src="Pictures/Intro and footer/GitHub.png" alt="GitHub">
            </a>  
          </div>
        </div>
      </div>  
    </div>
    <script src="index.js"></script>
</body>
</html>